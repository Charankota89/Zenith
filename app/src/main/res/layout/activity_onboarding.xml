<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/zenith_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="48dp"/>

        <!-- Dot indicators -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="40dp">
            <View android:id="@+id/dot1"
                android:layout_width="10dp" android:layout_height="10dp"
                android:background="@color/zenith_purple" android:layout_marginEnd="6dp"/>
            <View android:id="@+id/dot2"
                android:layout_width="10dp" android:layout_height="10dp"
                android:background="@color/zenith_purple" android:layout_marginEnd="6dp"/>
            <View android:id="@+id/dot3"
                android:layout_width="10dp" android:layout_height="10dp"
                android:background="@color/zenith_purple"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_next"
            android:backgroundTint="@color/zenith_purple"
            android:textColor="@color/white"
            android:textSize="16sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Sign in with Google"
            app:icon="@drawable/ic_google_logo"
            app:iconTint="@null"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            android:backgroundTint="#1F243D"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#404285F4"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:elevation="6dp"/>
    </LinearLayout>
</ScrollView>
